# ==============================================================================
# Docker Environment Configuration Template for Konkan Guide
# Copy to .env and adjust variables as needed: cp .env.docker.example .env
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx,your-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://your-domain.com

# Reverse Proxy & SSL Controls
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Local Docker Database (PostgreSQL)
POSTGRES_DB=konkan_db
POSTGRES_USER=konkan
POSTGRES_PASSWORD=konkan_password
DATABASE_URL=postgres://konkan:konkan_password@db:5432/konkan_db
DB_SSL_REQUIRE=False

# External Database (Optional Neon / Supabase / AWS RDS)
# DATABASE_URL=postgresql://user:password@aws.rds.amazonaws.com:5432/konkan_db?sslmode=require
# DB_SSL_REQUIRE=True

# Cloud Image Storage (Cloudinary - Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gunicorn Concurrency
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# Container Lifecycle Automations
RUN_MIGRATIONS=True
COLLECT_STATIC=True
AUTO_SEED_DATA=True

# Google OAuth (Sign in with Google)
# Get these from Google Cloud Console → APIs & Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
