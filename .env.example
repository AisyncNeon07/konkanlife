# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-local-dev-key-change-this-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# External Database (Neon Postgres / Supabase)
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
# Leave blank or commented out to use local SQLite (db.sqlite3)
DATABASE_URL=

# Cloud Image Storage (Cloudinary - 25GB Free)
# Sign up free at https://cloudinary.com and copy from Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (Sign in with Google)
# Get these from Google Cloud Console → APIs & Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
